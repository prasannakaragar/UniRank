{
  "name": "unirank-scraper",
  "version": "2.0.0",
  "description": "UniRank university data acquisition system — Crawlee + Cheerio/Playwright + Gemini",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "scrape:once": "tsx src/scripts/runOnce.ts",
    "scrape:seed": "tsx src/scripts/seedKarnataka.ts",
    "install:browser": "npx playwright install chromium",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cheerio": "^1.2.0",
    "crawlee": "^3.12.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.44.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
